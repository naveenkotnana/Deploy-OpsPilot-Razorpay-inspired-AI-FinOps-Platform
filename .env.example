# ---------------------------------------------------------------- database
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./opspilot.db
# PostgreSQL (docker compose):
# DATABASE_URL=postgresql+psycopg2://opspilot:opspilot@localhost:5432/opspilot

# ------------------------------------------------------------------ ollama
# LOCAL ONLY. No paid LLM API keys exist in this project.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_TIMEOUT=90

# --------------------------------------------------------------------- rag
EMBEDDING_MODE=tfidf
EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# -------------------------------------------------------------------- auth
# Generate your own: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-your-local-env
JWT_EXPIRE_MINUTES=120

# ------------------------------------------------------------- sql guards
SQL_ROW_LIMIT=200
SQL_TIMEOUT_S=10

BILLING_MONTH=2026-09
API_BASE_URL=http://localhost:8000
